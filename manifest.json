{
  "manifest_version": 3,
  "name": "DevReload",
  "version": "1.0.0",
  "description": "Watch local files for changes and automatically reload the active browser tab. Uses the File System Access API — no server required.",
  "permissions": ["storage", "tabs", "activeTab", "scripting", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
